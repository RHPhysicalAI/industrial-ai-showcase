# This project was developed with assistance from AI tools.
# Phase 1 host-native VLA server. Two build modes:
#
# MOCK (default; fast; no GPU; no model download): ~300 MB image.
#   podman build -f workloads/vla-serving-host/container/Containerfile \
#     -t localhost/openvla-server:dev .
#
# REAL (with CUDA + PyTorch, for running actual OpenVLA-7B on NVIDIA GPUs):
#   podman build -f workloads/vla-serving-host/container/Containerfile \
#     --build-arg=BASE_FLAVOR=cuda \
#     -t localhost/openvla-server:cuda .
#
# Swap the Quadlet Image= to the tag you want. Use :dev for wiring verification,
# :cuda once you're ready for real inference.
ARG BASE_FLAVOR=slim

FROM registry.access.redhat.com/ubi9/python-312:latest AS slim

FROM nvcr.io/nvidia/pytorch:25.09-py3 AS cuda
# NVIDIA PyTorch 2.9 + CUDA 13.0 + Python 3.12 pre-installed.
# Matches GR00T SDK's torch==2.9.0 pin so all pre-compiled C extensions
# (transformer_engine, apex, flash-attn) stay ABI-compatible.
ENV PIP_BREAK_SYSTEM_PACKAGES=1
ENV PIP_ROOT_USER_ACTION=ignore

FROM ${BASE_FLAVOR} AS final

USER 0

ENV PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /opt/app

COPY workloads/vla-serving-host/pyproject.toml /opt/app/vla-serving-host/
COPY workloads/vla-serving-host/src /opt/app/vla-serving-host/src

# Install service-level deps. In :slim we install everything except torch/torchvision
# (the service defaults to VLA_MODE=mock which never imports torch). In :rocm the
# base already has torch; we install --no-deps to avoid overwriting it.
RUN pip3 install --no-cache-dir \
        fastapi "uvicorn[standard]" \
        pydantic pydantic-settings \
        structlog pillow numpy boto3 \
    && pip3 install --no-cache-dir --no-deps /opt/app/vla-serving-host \
    && chown -R 1001:0 /opt/app

# GR00T N1.7 SDK + inference deps (cuda only).
# The base image ships a matched set of torch + transformer_engine + flash-attn +
# apex. Installing gr00t normally would upgrade torch from the base image's custom
# build (2.9.0a0+...) to the PyPI release (2.9.0), breaking all pre-compiled C
# extensions. Following NVIDIA's recommended pattern: install gr00t with --no-deps,
# then install its Python-only dependencies separately without touching torch.
# ref: https://next.redhat.com/2025/08/26/a-developers-guide-to-pytorch-containers-and-nvidia-solving-the-puzzle/
ARG GROOT_REF=main
RUN if [ -f /etc/os-release ] && grep -q ubuntu /etc/os-release; then \
        apt-get update && apt-get install -y --no-install-recommends git && \
        git clone --depth 1 --branch "${GROOT_REF}" \
            https://github.com/NVIDIA/Isaac-GR00T.git /workspace/Isaac-GR00T && \
        cd /workspace/Isaac-GR00T && \
        pip3 install --no-cache-dir --no-deps . && \
        pip3 install --no-cache-dir \
            albumentations==1.4.18 \
            "huggingface-hub[cli]" \
            "opencv-python-headless>=4.5,<4.13" \
            diffusers==0.35.1 dm-tree \
            lmdb==1.7.5 msgpack==1.1.0 msgpack-numpy==0.4.8 \
            pandas==2.2.3 peft==0.17.1 termcolor==3.2.0 \
            transformers==4.57.3 tyro==0.9.17 click==8.1.8 \
            datasets==3.6.0 "cryptography>=46.0.7" \
            einops==0.8.1 gitpython==3.1.50 jsonlines==4.0.0 \
            gymnasium==1.2.2 matplotlib==3.10.1 numpy==1.26.4 \
            omegaconf==2.3.0 scipy==1.15.3 \
            wandb==0.23.0 pyzmq==27.0.1 \
            "onnx>=1.20.0" onnxscript \
            onnxruntime-gpu sentencepiece && \
        pip3 install --no-cache-dir --no-deps \
            torchcodec==0.8.0 deepspeed==0.17.6 && \
        rm -rf /var/lib/apt/lists/* ; \
    fi

USER 1001

EXPOSE 8000

CMD ["uvicorn", "openvla_server.main:app", "--host", "0.0.0.0", "--port", "8000"]
