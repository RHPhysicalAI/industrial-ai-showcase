# Hosted SNO supplied by demo.redhat.com.
# Copy this file to .env and fill in environment-specific values.
# The real .env is ignored and must never be committed.

DEMO_SNO_KUBECONFIG="$HOME/.kube/demo-redhat-sno.kubeconfig"
DEMO_SNO_NAME="demo-redhat-sno"
DEMO_SNO_API_URL="https://<provided-by-demo.redhat>:6443"
DEMO_SNO_CONSOLE_URL="https://<console-provided-by-demo.redhat>"
DEMO_SNO_INGRESS_DOMAIN="<apps-domain-provided-by-demo.redhat>"
DEMO_SNO_EXPIRES_AT="<YYYY-MM-DD>"

# Used later for ACM registration and cross-cluster workload configuration.
HUB_KUBECONFIG="$HOME/.kube/hub.kubeconfig"
HUB_CONTEXT="<local-oc-context-for-hub>"
HUB_KAFKA_NAMESPACE="fleet-ops"
HUB_KAFKA_ROUTE="<fleet-kafka-bootstrap-route>"
HUB_KAFKA_CA_SECRET="fleet-cluster-ca-cert"
VLA_VM_IP="<vla-vm-ip>"
VLA_VM_PORT="8000"
VLA_ENDPOINT_URL="http://${VLA_VM_IP}:${VLA_VM_PORT}/act"
VLA_VM_SSH_HOST="${VLA_VM_IP}"
VLA_VM_SSH_USER="<provided-vm-user>"
VLA_VM_SSH_KEY="$HOME/.ssh/<provided-key>"
VLA_VM_OS="<fedora|rhel|ubuntu>"
VLA_GPU_VENDOR="nvidia"
VLA_GPU_MODEL="<provided-gpu-model>"
VLA_MODE="mock"
VLA_CONTAINER_IMAGE="localhost/openvla-server:cuda"

# Git source used by hosted-SNO BuildConfigs and GitOps.
GIT_REPO_URL="https://github.com/rhkp/industrial-ai-showcase.git"
GIT_REPO_REF="main"
