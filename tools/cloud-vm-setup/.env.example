# Cloud GPU VM used by the hosted demo.redhat.com SNO.
# Copy to .env and fill in real values locally. Never commit .env.

VLA_VM_IP="<cloud-vm-ip>"
VLA_VM_SSH_USER="<cloud-vm-user>"
VLA_VM_SSH_KEY="$HOME/.ssh/<cloud-vm-key>"
VLA_VM_SSH_PORT="22"

# The cloud VM profile targets Ubuntu GPU hosts.
VLA_VM_OS_FAMILY="Ubuntu"
VLA_GPU_VENDOR="nvidia"
VLA_GPU_MODEL="<gpu-model>"
VLA_INSTALL_NVIDIA_DRIVER="true"
VLA_REBOOT_AFTER_DRIVER="true"

VLA_PORT="8000"
VLA_MODE="mock"
VLA_BASE_FLAVOR="slim"
VLA_CONTAINER_IMAGE="localhost/openvla-server:slim"
VLA_INSTALL_GROOT="false" # false for the legacy OpenVLA image; true for GR00T/canary images.
VLA_MODEL_WEIGHTS="openvla/openvla-7b"
VLA_MODEL_CACHE="/var/cache/vla-models"
# Set these for a native GR00T artifact staged on the VM. Leave the path empty
# for the legacy OpenVLA mode.
VLA_GROOT_MODEL_PATH=""
VLA_GROOT_EMBODIMENT_TAG="REAL_G1"
VLA_GROOT_VIDEO_KEY="ego_view"

# Use the SNO's actual egress address/CIDR, not its private cluster CIDR.
# Do not use 0.0.0.0/0 for the demo service.
VLA_ALLOWED_SOURCE_CIDR="<sno-egress-public-ip>/32"

VLA_GIT_REPO_URL="https://github.com/rhkp/industrial-ai-showcase.git"
VLA_GIT_REPO_REF="main"
# Use working-tree for a local uncommitted build; use git for reproducible refs.
VLA_BUILD_SOURCE_MODE="git"
VLA_BUILD_IMAGE="true"
VLA_FORCE_IMAGE_BUILD="false"

# Required only when VLA_MODE=openvla. Keep this value local.
VLA_HF_TOKEN=""
